rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'preferredAiProvider',
          'preferredVoiceEngine',
          'preferredGoogleVoice',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'preferredAiProvider',
          'preferredVoiceEngine',
          'preferredGoogleVoice',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.preferredAiProvider in ['gemini', 'chatgpt']
        && data.preferredVoiceEngine in ['google-ai', 'browser']
        && data.preferredGoogleVoice in ['Kore', 'Zephyr', 'Puck', 'Charon', 'Fenrir']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyGoal(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'goalType',
          'target',
          'dateKey',
          'minutesCompleted',
          'pagesCompleted',
          'streakDays',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'goalType',
          'target',
          'dateKey',
          'minutesCompleted',
          'pagesCompleted',
          'streakDays',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.goalType in ['minutes', 'pages']
        && data.target is int
        && data.target >= 1
        && data.target <= 600
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.minutesCompleted is int
        && data.minutesCompleted >= 0
        && data.minutesCompleted <= 1440
        && data.pagesCompleted is int
        && data.pagesCompleted >= 0
        && data.pagesCompleted <= 2000
        && data.streakDays is int
        && data.streakDays >= 0
        && data.streakDays <= 36500
        && data.updatedAt is timestamp;
    }

    function isValidScheduleSlot(data, userId, dayKey) {
      return data.keys().hasAll([
          'ownerId',
          'dayKey',
          'enabled',
          'timeOfDay',
          'notificationsEnabled',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'dayKey',
          'enabled',
          'timeOfDay',
          'notificationsEnabled',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.dayKey in ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun']
        && data.dayKey == dayKey
        && data.enabled is bool
        && data.timeOfDay is string
        && data.timeOfDay.size() == 5
        && data.timeOfDay.matches('^[0-2][0-9]:[0-5][0-9]$')
        && data.notificationsEnabled is bool
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'preferredAiProvider',
          'preferredVoiceEngine',
          'preferredGoogleVoice',
          'updatedAt'
        ]);
      allow delete: if false;

      match /goals/{goalId} {
        allow get: if isValidId(userId) && isValidId(goalId) && goalId == 'daily' && isVerifiedOwner(userId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(goalId)
          && goalId == 'daily'
          && isVerifiedOwner(userId)
          && isValidDailyGoal(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(goalId)
          && goalId == 'daily'
          && isVerifiedOwner(userId)
          && isValidDailyGoal(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'goalType',
            'target',
            'dateKey',
            'minutesCompleted',
            'pagesCompleted',
            'streakDays',
            'updatedAt'
          ]);
        allow delete: if false;
      }

      match /schedules/{dayKey} {
        allow get: if isValidId(userId) && isValidId(dayKey) && isVerifiedOwner(userId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(dayKey)
          && isVerifiedOwner(userId)
          && isValidScheduleSlot(incoming(), userId, dayKey)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(dayKey)
          && isVerifiedOwner(userId)
          && isValidScheduleSlot(incoming(), userId, dayKey)
          && incoming().ownerId == existing().ownerId
          && incoming().dayKey == existing().dayKey
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'enabled',
            'timeOfDay',
            'notificationsEnabled',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(dayKey) && isVerifiedOwner(userId);
      }
    }
  }
}
